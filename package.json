{
  "name": "labelgene",
  "version": "1.0.0",
  "description": "LabelGene - Label & Sticker Generator",
  "main": "main.js",
  "files": [
    "main.js",
    "preload.js",
    "index.html",
    "scripts/**/*",
    "styles/**/*",
    "libs/**/*"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "icon-512.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "build": {
    "appId": "com.harshdevelopments.labelgene",
    "productName": "LabelGene",
    "copyright": "Harsh Developments",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "main.js",
      "preload.js",
      "scripts/**/*",
      "styles/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}